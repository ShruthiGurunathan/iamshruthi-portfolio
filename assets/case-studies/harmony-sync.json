{
  "hero": "<img class=\"health-opening-image\" src=\"https://iamshruthi.com/assets/media/f7838007f7995ab994df.webp\" width=\"1536\" height=\"1024\" alt=\"Harmony Sync cover showing the portrait karaoke tablet interface\">",
  "subtitle": "<h2 class=\"subtitle\">A shared karaoke tablet that helps groups set the room vibe and see who’s up next.</h2>",
  "about": "<div class=\"content-align-right\"><div class=\"copy-block\"><h3 class=\"eyebrow\">about</h3><p class=\"body-copy-large\">Harmony Sync is a family-friendly private karaoke concept designed across a phone, room tablet and shared display. I designed the tablet experience in our team project, from wireframes and room controls to the final prototype and heuristic evaluation.</p></div></div>",
  "labels": [
    "userflows",
    "wireframes",
    "design system"
  ],
  "body": "<style>\n.harmony-screens,.harmony-system{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:var(--case-panel-gap,16px);width:100%;align-items:start}\n.harmony-tablet-flow.harmony-screens{grid-template-columns:repeat(8,minmax(0,1fr))}\n.harmony-tablet-flow>figure{grid-column:span 2}\n.harmony-tablet-flow>figure:nth-child(5){grid-column:2/span 2}\n.harmony-section figure{min-width:0;margin:0}\n.harmony-section .harmony-media{display:grid;grid-template:minmax(0,1fr)/minmax(0,1fr);width:100%;min-width:0;min-height:0;overflow:hidden}\n.harmony-screens figure,.harmony-system figure{display:flex;flex-direction:column;gap:8px}\n.harmony-screens figcaption,.harmony-system figcaption{min-height:2.5em}\n.harmony-section .harmony-screen .harmony-media{aspect-ratio:3/4}\n.harmony-section .harmony-screen img,.harmony-system .harmony-component img{display:block;width:100%;height:100%;min-width:0;min-height:0;padding:0;object-fit:contain}\n.harmony-detail{width:100%}\n.harmony-detail h3{margin:0 0 8px;font:italic 400 28px/1.2 \"Xanh Mono\",Georgia,serif}\n.harmony-detail p{margin:0;max-width:68ch}\n.harmony-flow{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:16px;width:100%;margin:0;padding:0;list-style:none}\n.harmony-flow li{display:flex;align-items:flex-end;padding:0 0 12px;border-bottom:1px dashed currentColor}\n.harmony-system.health-system-overview{grid-template-columns:repeat(3,minmax(0,1fr));gap:16px;align-items:start}\n.harmony-system-column{display:grid;gap:16px;min-width:0}\n.harmony-system .harmony-component{background:#eae7df;padding:14px;border-radius:var(--case-media-radius);min-width:0}\n.harmony-system .harmony-component .harmony-media{aspect-ratio:4/3}\n@media(max-width:767px){\n .harmony-screens{grid-template-columns:repeat(2,minmax(0,1fr))}\n .harmony-tablet-flow.harmony-screens{grid-template-columns:repeat(6,minmax(0,1fr))}\n .harmony-tablet-flow>figure:nth-child(5){grid-column:span 2}\n .harmony-tablet-flow>figure:nth-child(4),.harmony-tablet-flow>figure:nth-child(6){grid-column:2/span 2}\n .harmony-flow{grid-template-columns:repeat(3,minmax(0,1fr))}\n .harmony-system.health-system-overview{grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}\n .harmony-system-column{display:contents}\n .harmony-system .harmony-component{padding:10px}\n}\n@media(max-width:479px){.harmony-detail h3{font-size:24px}.harmony-tablet-flow.harmony-screens{grid-template-columns:1fr}.harmony-tablet-flow>figure:nth-child(n){grid-column:1}.harmony-flow{grid-template-columns:repeat(2,minmax(0,1fr))}.harmony-system.health-system-overview{grid-template-columns:1fr}}\n.harmony-device-intro{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px;align-items:start}\n.harmony-screens.harmony-devices{grid-template-columns:repeat(2,minmax(0,1fr))}\n.harmony-section .harmony-devices .harmony-media{aspect-ratio:4/3}\n@media(max-width:767px){.harmony-device-intro{grid-template-columns:1fr;gap:12px}}\n@media(max-width:479px){.harmony-screens.harmony-devices{grid-template-columns:1fr}}\n</style><div class=\"content-section harmony-brand\">\n      <figure class=\"health-panel harmony-project-logo\">\n        <img src=\"https://iamshruthi.com/assets/harmony-sync/project-logo.webp?v=2\" width=\"980\" height=\"426\" alt=\"HarmonySync logo\" loading=\"lazy\" decoding=\"async\">\n      </figure>\n    </div>\n    <section class=\"content-align-left\">\n      <div class=\"content-section harmony-section\">\n        <div data-wf--section-header--variant=\"horizontal\" class=\"section-copy-wrap health-aligned-userflows\">\n          <h2 class=\"display-medium\"><span class=\"display-medium-alt_wrap\">01</span>userflows</h2>\n          <div class=\"caption\"><p class=\"body-copy-small\">The tablet guides the group from joining the room to handing the mic to the next singer. A QR code or manual table code connects the devices, and the queue and room status update across them.</p></div>\n        </div>\n        <ol class=\"harmony-flow body-copy-small\">\n<li>Connect the room</li><li>See how the devices work together</li><li>Set the vibe</li><li>Get ready</li><li>Perform</li><li>Celebrate and hand over</li>\n</ol><div class=\"harmony-screens harmony-tablet-flow\">\n<figure class=\"health-panel harmony-screen\">\n      <figcaption class=\"health-panel-title\">Connect the room</figcaption>\n      <div class=\"harmony-media\"><img src=\"https://iamshruthi.com/assets/harmony-sync/final-tablet-welcome.webp\" width=\"831\" height=\"1194\" loading=\"lazy\" decoding=\"async\" alt=\"Tablet welcome screen with a QR code and a manual table-code field\"></div>\n    </figure>\n<figure class=\"health-panel harmony-screen\">\n      <figcaption class=\"health-panel-title\">See how the devices work together</figcaption>\n      <div class=\"harmony-media\"><img src=\"https://iamshruthi.com/assets/harmony-sync/final-tablet-onboarding.webp\" width=\"834\" height=\"1194\" loading=\"lazy\" decoding=\"async\" alt=\"Guidance overlay explaining how the three devices work together\"></div>\n    </figure>\n<figure class=\"health-panel harmony-screen\">\n      <figcaption class=\"health-panel-title\">Set the vibe</figcaption>\n      <div class=\"harmony-media\"><img src=\"https://iamshruthi.com/assets/harmony-sync/final-tablet-vibe.webp\" width=\"834\" height=\"1194\" loading=\"lazy\" decoding=\"async\" alt=\"Vibe presets and room lighting, volume, and effects controls\"></div>\n    </figure>\n<figure class=\"health-panel harmony-screen\">\n      <figcaption class=\"health-panel-title\">Get ready</figcaption>\n      <div class=\"harmony-media\"><img src=\"https://iamshruthi.com/assets/harmony-sync/final-tablet-ready.webp\" width=\"838\" height=\"1605\" loading=\"lazy\" decoding=\"async\" alt=\"Next singer countdown, queue position, and readiness controls\"></div>\n    </figure>\n<figure class=\"health-panel harmony-screen\">\n      <figcaption class=\"health-panel-title\">Perform</figcaption>\n      <div class=\"harmony-media\"><img src=\"https://iamshruthi.com/assets/harmony-sync/final-tablet-perform.webp\" width=\"834\" height=\"1194\" loading=\"lazy\" decoding=\"async\" alt=\"Live performance screen with playback, microphone and audience reaction controls\"></div>\n    </figure>\n<figure class=\"health-panel harmony-screen\">\n      <figcaption class=\"health-panel-title\">Hand over · Great Performance</figcaption>\n      <div class=\"harmony-media\"><img src=\"https://iamshruthi.com/assets/harmony-sync/final-tablet-great.webp\" width=\"834\" height=\"1194\" loading=\"lazy\" decoding=\"async\" alt=\"Celebration screen that names the next singer\"></div>\n    </figure>\n<figure class=\"health-panel harmony-screen\">\n      <figcaption class=\"health-panel-title\">Hand over · Nice Effort</figcaption>\n      <div class=\"harmony-media\"><img src=\"https://iamshruthi.com/assets/harmony-sync/final-tablet-nice.webp\" width=\"834\" height=\"1194\" loading=\"lazy\" decoding=\"async\" alt=\"Nice Effort message and a preview of the next singer\"></div>\n    </figure>\n</div>\n<div class=\"harmony-detail harmony-device-intro\"><h3>How the devices work together</h3><p class=\"body-copy-small\">Guests browse and queue songs on their phones. The shared display makes lyrics and the next singer visible to the room, while the tablet handles room settings, performer readiness and audience reactions. After a song, the tablet can show either celebration or encouragement before handing over.</p></div>\n<div class=\"harmony-screens harmony-devices\"><figure class=\"health-panel harmony-screen\">\n      <figcaption class=\"health-panel-title\">Phone · Browse songs</figcaption>\n      <div class=\"harmony-media\"><img src=\"https://iamshruthi.com/assets/harmony-sync/phone-song-browse.webp\" width=\"322\" height=\"700\" loading=\"lazy\" decoding=\"async\" alt=\"Personal song browsing with genre filters, search and recommendations\"></div>\n    </figure><figure class=\"health-panel harmony-screen\">\n      <figcaption class=\"health-panel-title\">Shared display · See who’s next</figcaption>\n      <div class=\"harmony-media\"><img src=\"https://iamshruthi.com/assets/harmony-sync/shared-display.webp\" width=\"768\" height=\"426\" loading=\"lazy\" decoding=\"async\" alt=\"Shared karaoke display showing the next singer and audience reactions\"></div>\n    </figure></div>\n      </div>\n    </section><section class=\"content-align-left\">\n      <div class=\"content-section harmony-section\">\n        <div data-wf--section-header--variant=\"horizontal\" class=\"section-copy-wrap health-aligned-userflows\">\n          <h2 class=\"display-medium\"><span class=\"display-medium-alt_wrap\">02</span>wireframes</h2>\n          <div class=\"caption\"><p class=\"body-copy-small\">The tablet went through four Figma iterations. Feedback highlighted unclear onboarding, too many similar settings icons and uncertainty about who would sing next.</p></div>\n        </div>\n        <div class=\"harmony-screens\"><figure class=\"health-panel harmony-screen\">\n      <figcaption class=\"health-panel-title\">01 · Low fidelity</figcaption>\n      <div class=\"harmony-media\"><img src=\"https://iamshruthi.com/assets/harmony-sync/low-detail.webp\" width=\"769\" height=\"1100\" loading=\"lazy\" decoding=\"async\" alt=\"Early wireframe for choosing a room vibe\"></div>\n    </figure><figure class=\"health-panel harmony-screen\">\n      <figcaption class=\"health-panel-title\">02 · Mid fidelity</figcaption>\n      <div class=\"harmony-media\"><img src=\"https://iamshruthi.com/assets/harmony-sync/mid-detail.webp\" width=\"769\" height=\"1100\" loading=\"lazy\" decoding=\"async\" alt=\"Iteration with illustrated Party, Chill and Neon presets\"></div>\n    </figure><figure class=\"health-panel harmony-screen\">\n      <figcaption class=\"health-panel-title\">03 · Final ambience controls</figcaption>\n      <div class=\"harmony-media\"><img src=\"https://iamshruthi.com/assets/harmony-sync/final-tablet-vibe.webp\" width=\"834\" height=\"1194\" loading=\"lazy\" decoding=\"async\" alt=\"Final dark tablet screen with three distinct vibe presets and labelled room controls\"></div>\n    </figure></div>\n<div class=\"harmony-detail\"><h3>Make the handover clearer</h3><p class=\"body-copy-small\">Five participants reviewed the tablet against Nielsen’s usability heuristics. The review found six severity-1 issues and four severity-2 issues, including unclear queue position, performer readiness and onboarding. I added a position-in-queue panel, an “I’m Ready” action and a short guide explaining the role of each device.</p></div>\n<div class=\"harmony-detail\"><h3>Separate the main controls</h3><p class=\"body-copy-small\">Design feedback prompted a visible manual table-code field, a consistent Home button and fewer settings icons. I also moved the key control closer to its label and made song and singer information easier to distinguish.</p></div>\n      </div>\n    </section><section class=\"content-align-left\">\n      <div class=\"content-section harmony-section\">\n        <div data-wf--section-header--variant=\"horizontal\" class=\"section-copy-wrap harmony-system-heading\">\n          <h2 class=\"display-medium\"><span class=\"display-medium-alt_wrap\">03</span>design system</h2>\n          <div class=\"caption\"><p class=\"body-copy-small\">The tablet’s component board brings together the controls for joining a room, setting the vibe and passing the mic.</p></div>\n        </div>\n        <div class=\"health-system-grid harmony-system health-system-overview\">\n<div class=\"harmony-system-column\">\n<figure class=\"health-panel harmony-component\">\n  <figcaption class=\"health-panel-title\">Tablet palette</figcaption>\n  <div class=\"harmony-media\"><img class=\"health-panel-image\" src=\"https://iamshruthi.com/assets/harmony-sync/component-palette.webp\" width=\"757\" height=\"270\" alt=\"Warm orange and brown shades with olive, slate blue and muted yellow accents\" loading=\"lazy\" decoding=\"async\"></div>\n</figure>\n<figure class=\"health-panel harmony-component\">\n  <figcaption class=\"health-panel-title\">Tablet typography</figcaption>\n  <div class=\"harmony-media\"><img class=\"health-panel-image\" src=\"https://iamshruthi.com/assets/harmony-sync/component-type.webp\" width=\"952\" height=\"495\" alt=\"Tablet-specific heading and body text samples\" loading=\"lazy\" decoding=\"async\"></div>\n</figure>\n<figure class=\"health-panel harmony-component\">\n  <figcaption class=\"health-panel-title\">Icon states</figcaption>\n  <div class=\"harmony-media\"><img class=\"health-panel-image\" src=\"https://iamshruthi.com/assets/harmony-sync/component-icon-states.webp\" width=\"805\" height=\"220\" alt=\"Tablet icon controls in default, hover and focus states\" loading=\"lazy\" decoding=\"async\"></div>\n</figure>\n<figure class=\"health-panel harmony-component\">\n  <figcaption class=\"health-panel-title\">Celebration feedback</figcaption>\n  <div class=\"harmony-media\"><img class=\"health-panel-image\" src=\"https://iamshruthi.com/assets/harmony-sync/component-feedback.webp\" width=\"620\" height=\"604\" alt=\"Celebration illustration and circular feedback treatments\" loading=\"lazy\" decoding=\"async\"></div>\n</figure>\n</div>\n<div class=\"harmony-system-column\">\n<figure class=\"health-panel harmony-component\">\n  <figcaption class=\"health-panel-title\">Vibe cards</figcaption>\n  <div class=\"harmony-media\"><img class=\"health-panel-image\" src=\"https://iamshruthi.com/assets/harmony-sync/component-vibe-states.webp\" width=\"664\" height=\"445\" alt=\"Party, Chill and Neon cards with hover and selected states\" loading=\"lazy\" decoding=\"async\"></div>\n</figure>\n<figure class=\"health-panel harmony-component\">\n  <figcaption class=\"health-panel-title\">Reaction and continue buttons</figcaption>\n  <div class=\"harmony-media\"><img class=\"health-panel-image\" src=\"https://iamshruthi.com/assets/harmony-sync/component-reactions-clean.webp\" width=\"1031\" height=\"437\" alt=\"Cheer, Applause and Continue with interaction states\" loading=\"lazy\" decoding=\"async\"></div>\n</figure>\n<figure class=\"health-panel harmony-component\">\n  <figcaption class=\"health-panel-title\">Primary button states</figcaption>\n  <div class=\"harmony-media\"><img class=\"health-panel-image\" src=\"https://iamshruthi.com/assets/harmony-sync/component-buttons.webp\" width=\"1107\" height=\"330\" alt=\"Tablet action buttons at several sizes and states\" loading=\"lazy\" decoding=\"async\"></div>\n</figure>\n<figure class=\"health-panel harmony-component\">\n  <figcaption class=\"health-panel-title\">Onboarding prompt</figcaption>\n  <div class=\"harmony-media\"><img class=\"health-panel-image\" src=\"https://iamshruthi.com/assets/harmony-sync/component-onboarding.webp\" width=\"526\" height=\"465\" alt=\"Welcome overlay explaining what each device does\" loading=\"lazy\" decoding=\"async\"></div>\n</figure>\n</div>\n<div class=\"harmony-system-column\">\n<figure class=\"health-panel harmony-component\">\n  <figcaption class=\"health-panel-title\">Singer and queue cards</figcaption>\n  <div class=\"harmony-media\"><img class=\"health-panel-image\" src=\"https://iamshruthi.com/assets/harmony-sync/component-singer-queue.webp\" width=\"1580\" height=\"698\" alt=\"Countdown, current singer, mic controls, Up Next and position in queue\" loading=\"lazy\" decoding=\"async\"></div>\n</figure>\n<figure class=\"health-panel harmony-component\">\n  <figcaption class=\"health-panel-title\">Navigation and status bars</figcaption>\n  <div class=\"harmony-media\"><img class=\"health-panel-image\" src=\"https://iamshruthi.com/assets/harmony-sync/component-navigation.webp\" width=\"622\" height=\"475\" alt=\"Tablet header and footer states for table, music, audio, microphone and transition effects\" loading=\"lazy\" decoding=\"async\"></div>\n</figure>\n<figure class=\"health-panel harmony-component\">\n  <figcaption class=\"health-panel-title\">Sliders, progress and playback</figcaption>\n  <div class=\"harmony-media\"><img class=\"health-panel-image\" src=\"https://iamshruthi.com/assets/harmony-sync/component-audio.webp\" width=\"1035\" height=\"705\" alt=\"Audio slider and progress bar variants, countdown ring and playback controls\" loading=\"lazy\" decoding=\"async\"></div>\n</figure>\n<figure class=\"health-panel harmony-component\">\n  <figcaption class=\"health-panel-title\">Effects dropdown</figcaption>\n  <div class=\"harmony-media\"><img class=\"health-panel-image\" src=\"https://iamshruthi.com/assets/harmony-sync/component-dropdown.webp\" width=\"1185\" height=\"275\" alt=\"Echo dropdown open and closed states\" loading=\"lazy\" decoding=\"async\"></div>\n</figure>\n</div>\n</div>\n<div class=\"harmony-detail\"><h3>What the system carries across screens</h3><p class=\"body-copy-small\">Vibe cards, countdowns and labelled audio controls give each stage a recognisable structure. Clearer primary and secondary actions help people distinguish the next step from optional controls.</p></div>\n      </div>\n    </section>\n    <section aria-label=\"Prototype walkthrough\">\n      <figure class=\"harmony-walkthrough\">\n        <figcaption class=\"harmony-walkthrough-label\">tablet prototype walkthrough</figcaption>\n        <video src=\"https://iamshruthi.com/assets/harmony-sync/tablet-walkthrough.mp4?v=2\" poster=\"https://iamshruthi.com/assets/harmony-sync/tablet-walkthrough.jpg?v=2\" width=\"720\" height=\"1026\" preload=\"metadata\" autoplay loop muted playsinline aria-label=\"HarmonySync tablet prototype walkthrough\"></video>\n      </figure>\n    </section>"
}
